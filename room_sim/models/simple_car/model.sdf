<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="simple_car">
    <static>false</static>
    <pose>0 0 0.06 0 0 0</pose>

    <!-- Chassis -->
    <link name="chassis">
      <pose>0 0 0.06 0 0 0</pose>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>

        <!-- Flashy pink -->
        <material>
          <ambient>1.0 0.2 0.7 1</ambient>
          <diffuse>1.0 0.2 0.7 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <emissive>1.0 0.2 0.7 1</emissive>
        </material>
      </visual>
      <!-- Front laser / range sensor -->
        <sensor name="front_laser" type="gpu_lidar">
        <pose>0.16 0 0.06 0 0 0</pose>

        <topic>/front_laser</topic>
        <update_rate>100</update_rate>

        <lidar>
            <scan>
            <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
            </horizontal>
            </scan>

            <range>
            <min>0.02</min>
            <max>5.0</max>
            <resolution>0.001</resolution>
            </range>
        </lidar>

        <always_on>true</always_on>
        <visualize>true</visualize>
        </sensor>

    </link>

    <!-- Helper: wheel collision + visual rotate cylinder so its axis aligns with joint axis (Y) -->
    <!-- Wheels (white) -->

    <!-- Front-left wheel -->
    <link name="left_front_wheel">
      <pose>0.10 0.12 0.03 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000052</ixx>
          <iyy>0.000090</iyy>
          <izz>0.000052</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        <emissive>0.6 0.6 0.6 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Rear-left wheel -->
    <link name="left_rear_wheel">
      <pose>-0.10 0.12 0.03 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000052</ixx>
          <iyy>0.000090</iyy>
          <izz>0.000052</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <emissive>0.6 0.6 0.6 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Front-right wheel -->
    <link name="right_front_wheel">
      <pose>0.10 -0.12 0.03 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000052</ixx>
          <iyy>0.000090</iyy>
          <izz>0.000052</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <emissive>0.6 0.6 0.6 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Rear-right wheel -->
    <link name="right_rear_wheel">
      <pose>-0.10 -0.12 0.03 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000052</ixx>
          <iyy>0.000090</iyy>
          <izz>0.000052</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <emissive>0.6 0.6 0.6 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Joints (each wheel joint spins around Y) -->
    <joint name="left_front_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="left_rear_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_front_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_rear_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Diff drive: list both left joints and both right joints -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>

      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>

  </model>
</sdf>
